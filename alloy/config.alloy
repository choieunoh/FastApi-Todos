// ① 수집 대상 찾기: Docker 소켓으로 실행 중인 컨테이너를 조회하고,
//    docker compose 서비스 이름이 fastapi-app 인 컨테이너만 남김
discovery.docker "fastapi" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = ["com.docker.compose.service=fastapi-app"]
  }
}

// ② 라벨 정리: 컨테이너 이름("/FastApi-app")의 앞 '/'를 떼고 container 라벨로 저장
discovery.relabel "fastapi" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

// ③ 로그 읽기: 컨테이너의 stdout/stderr 로그를 계속 읽어(tail) 다음 단계로 전달
//    application="fastapi" 라벨을 붙이므로 기존 LogQL 쿼리를 그대로 사용할 수 있음
loki.source.docker "fastapi" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.fastapi.targets
  labels        = {"application" = "fastapi"}
  relabel_rules = discovery.relabel.fastapi.rules
  forward_to    = [loki.write.local.receiver]
}

// ④ 전송: Loki의 Push API로 로그를 밀어 넣음 (HTTP Push)
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}